POSTGRES_DB=quant_trading
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_password
POSTGRES_PORT=5432

# 生产角色切换时分别配置；留空时 Compose 保持既有单一数据库身份。
API_DATABASE_URL=
RESEARCH_WORKER_DATABASE_URL=
PRIVATE_DATABASE_URL=

# 个人工作台仅在显式叠加 docker-compose.personal.yml 时启用。
PERSONAL_GATEWAY_TOKEN_HOST_FILE=
PERSONAL_DATA_KEYRING_HOST_FILE=
PERSONAL_ALLOWED_ORIGINS=
ALPACA_CREDENTIALS_HOST_FILE=
ALPACA_AUTHORIZATION_HOST_FILE=
OFFICIAL_ANALYSIS_QUERY_HOST_FILE=
OFFICIAL_ANALYSIS_AUTHORIZATION_HOST_FILE=
SEC_USER_AGENT=

# 个人 AI 分析执行模式：legacy（单发、冻结证据）| agent（tool-use agent，持仓/K线/新闻工具）。
# 切换到 agent 前需在 alpaca 授权文件中对 daily bars 授予 ai_context 用途。
PERSONAL_ANALYSIS_MODE=legacy
# investment-news 项目 checkout 目录（agent 模式的新闻工具数据源）；留空则新闻工具不可用。
INVESTMENT_NEWS_HOST_DIR=
INVESTMENT_NEWS_DIR=/run/news

API_PORT=18000
FRONTEND_PORT=15173
DEEPSEEK_TOKEN=在这里填你的_deepseek_token
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com

PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_CONFIG_REGISTRY=

# 第一阶段仅通过 SSH 隧道访问本机 loopback；内部读回经 frontend 服务代理到 API。
RESEARCH_PUBLIC_BASE_URL=http://127.0.0.1:15173
RESEARCH_READBACK_BASE_URL=http://frontend:5173
RESEARCH_PUBLICATION_RETRY_SECONDS=300

DEV_SERVER_HOST=182.254.180.169
DEV_SERVER_USER=ubuntu
DEV_SERVER_SSH_PORT=22
DEV_SERVER_SSH_KEY=/Users/jettlin/.ssh/quantitative_trading_server_ed25519

REMOTE=ubuntu@182.254.180.169
REMOTE_SSH_PORT=22
REMOTE_SSH_KEY=/Users/jettlin/.ssh/quantitative_trading_server_ed25519
PROJECT_DIR=/opt/quantitative-trading
REPO_URL=ssh://git@ssh.github.com:443/Jettlin927/Quantitative_trading.git
BRANCH=main
LOCAL_KEY=/Users/jettlin/.ssh/id_ed25519
REMOTE_KEY=.ssh/quantitative_trading_github
COMPOSE_SERVER_FILE=docker-compose.server.yml
# 留空时维持既有部署；个人工作台切换时显式设为 docker-compose.personal.yml。
COMPOSE_PERSONAL_FILE=
API_BASE=http://127.0.0.1:18000
