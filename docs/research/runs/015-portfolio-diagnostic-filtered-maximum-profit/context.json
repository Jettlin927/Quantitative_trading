    "lotSize": 100
  },
  "costs": {
    "commissionPct": 0.00025,
    "stampDutyPct": 0.0005
  },
  "risk": {
    "stopLossPct": 0.05,
    "takeProfit1Pct": 0.03,
    "takeProfit2Pct": 0.05,
